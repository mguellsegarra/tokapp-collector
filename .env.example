# TokApp. No pugis mai aquest fitxer amb valors reals.
TOKAPP_USERNAME=
TOKAPP_PASSWORD=
TOKAPP_BASE_URL=https://app.tokapp.net/?
TOKAPP_APP_VERSION=5.0.0

# Comença en false. Activa-ho només després de validar un missatge real.
TOKAPP_ACK_RECEIVED=false
POLL_INTERVAL_SECONDS=180
REQUEST_TIMEOUT_SECONDS=25

# Persistència local, un JSON per missatge i un JSON per esdeveniment agrupat.
DATA_DIR=data
RULES_PATH=config/rules.local.json
DEDUP_WINDOW_HOURS=48

# openai genera resums amb IA; rules aplica regles locals sense una API d'IA.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Telegram. Els topic IDs són opcionals; sense topics tot va al mateix xat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_IMPORTANT_TOPIC_ID=
TELEGRAM_OTHER_TOPIC_ID=
TELEGRAM_ERROR_TOPIC_ID=
# telegram envia els missatges; local només els conserva en JSON.
PUBLISHER=telegram
